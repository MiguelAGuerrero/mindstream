diff --git a/src/notesStore.js b/src/notesStore.js
index 3a1f2c4..9be07d1 100644
--- a/src/notesStore.js
+++ b/src/notesStore.js
@@ -4,6 +4,7 @@ import { load, save } from "./storage";
 export const useNotes = create((set, get) => ({
   notes: load("notes") ?? [],
+  pinned: load("pinned") ?? [],
 
   addNote(text) {
     const note = { id: crypto.randomUUID(), text, createdAt: Date.now() };
@@ -17,4 +18,16 @@ export const useNotes = create((set, get) => ({
     set({ notes });
     save("notes", notes);
   },
+
+  pinNote(id) {
+    if (get().pinned.includes(id)) return;
+    const pinned = [id, ...get().pinned];
+    set({ pinned });
+    save("pinned", pinned);
+  },
+
+  sortedNotes() {
+    const { notes, pinned } = get();
+    return [...notes].sort((a, b) => pinned.includes(b.id) - pinned.includes(a.id) || b.createdAt - a.createdAt);
+  },
 }));
